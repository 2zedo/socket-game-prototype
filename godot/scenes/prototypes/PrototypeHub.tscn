[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/prototypes/PrototypeHub.gd" id="1_hub"]

[node name="PrototypeHub" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_hub")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.015, 0.018, 0.026, 1)

[node name="Margin" type="MarginContainer" parent="."]
