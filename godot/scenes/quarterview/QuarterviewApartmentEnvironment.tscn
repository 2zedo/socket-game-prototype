[sub_resource type="Shader" id="Shader_fridge_checker_cleanup"]
code = "shader_type canvas_item;

void fragment() {
	vec4 source = texture(TEXTURE, UV);
	float high = max(source.r, max(source.g, source.b));
	float low = min(source.r, min(source.g, source.b));
	float chroma = high - low;
	float neutral_bright_background = smoothstep(0.88, 0.96, high) * (1.0 - smoothstep(0.015, 0.055, chroma));
	source.a *= 1.0 - neutral_bright_background;
	COLOR = source;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_fridge_checker_cleanup"]
